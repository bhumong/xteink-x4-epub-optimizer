{
	"name": "xteink-x4-epub-optimizer",
	"version": "0.0.0",
	"lockfileVersion": 3,
	"requires": true,
	"packages": {
		"": {
			"name": "xteink-x4-epub-optimizer",
			"version": "0.0.0",
			"workspaces": [
				"packages/*",
				"apps/*"
			],
			"engines": {
				"node": ">=24"
			}
		},
		"apps/server": {
			"name": "@xteink/server",
			"version": "0.0.0"
		},
		"apps/web": {
			"name": "@xteink/web",
			"version": "0.0.0",
			"dependencies": {
				"@xteink/optimize": "*"
			}
		},
		"node_modules/@xteink/optimize": {
			"resolved": "packages/optimize",
			"link": true
		},
		"node_modules/@xteink/server": {
			"resolved": "apps/server",
			"link": true
		},
		"node_modules/@xteink/web": {
			"resolved": "apps/web",
			"link": true
		},
		"packages/optimize": {
			"name": "@xteink/optimize",
			"version": "0.0.0"
		}
	}
}
